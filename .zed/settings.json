{
  "format_on_save": "on",
  "prettier": { "allowed": false },
  "lsp": {
    "oxlint": {
      "initialization_options": {
        "settings": {
          "configPath": "./oxlint.config.ts",
          "run": "onType",
          "disableNestedConfig": false,
          "fixKind": "safe_fix",
          "unusedDisableDirectives": "deny"
        }
      }
    },
    "oxfmt": {
      "initialization_options": {
        "settings": { "fmt.configPath": "./oxfmt.config.ts", "run": "onSave" }
      }
    },
    "tailwindcss-language-server": {
      "settings": {
        "classFunctions": ["cva", "cx", "tv", "clsx", "cn", "tw\\.[a-z-]+"],
        "experimental": { "classRegex": ["[cls|className]\\s\\:\\=\\s\"([^\"]*)"] }
      }
    }
  },
  "languages": {
    "JavaScript": {
      "language_servers": [
        "tsgo",
        "oxlint",
        "!vtsls",
        "!typescript-language-server",
        "!eslint",
        "..."
      ],
      "formatter": [
        { "language_server": { "name": "oxfmt" } },
        { "code_action": "source.fixAll.oxc" }
      ]
    },
    "TypeScript": {
      "language_servers": [
        "tsgo",
        "oxlint",
        "!vtsls",
        "!typescript-language-server",
        "!eslint",
        "..."
      ],

      "formatter": [
        { "language_server": { "name": "oxfmt" } },
        { "code_action": "source.fixAll.oxc" }
      ]
    },
    "TSX": {
      "language_servers": [
        "tsgo",
        "oxlint",
        "!vtsls",
        "!typescript-language-server",
        "!eslint",
        "..."
      ],
      "formatter": [
        { "language_server": { "name": "oxfmt" } },
        { "code_action": "source.fixAll.oxc" }
      ]
    },
    "CSS": {
      "language_servers": ["tailwindcss-intellisense-css", "!vscode-css-language-server", "..."],
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "JSON": { "formatter": [{ "language_server": { "name": "oxfmt" } }] },
    "JSONC": { "formatter": [{ "language_server": { "name": "oxfmt" } }] },
    "Markdown": { "formatter": [{ "language_server": { "name": "oxfmt" } }] },
    "Markdown-Inline": { "formatter": [{ "language_server": { "name": "oxfmt" } }] },
    "MDX": { "formatter": [{ "language_server": { "name": "oxfmt" } }] },
    "YAML": { "formatter": [{ "language_server": { "name": "oxfmt" } }] }
  }
}
