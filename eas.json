{
  "cli": {
    "version": ">= 20.4.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "24.18.0",
      "yarn": "4.17.0"
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development",
      "android": { "buildType": "apk" },
      "ios": { "simulator": true },
      "corepack": true
    },
    "preview": { "extends": "base", "distribution": "internal", "corepack": true },
    "production": { "extends": "base", "autoIncrement": true, "corepack": true }
  },
  "submit": { "production": {} }
}
