{
  "cli": {
    "version": ">= 20.4.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {},
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development",
      "android": { "buildType": "apk" },
      "ios": { "simulator": true }
    },
    "preview": { "extends": "base", "distribution": "internal" },
    "production": { "extends": "base", "autoIncrement": true }
  },
  "submit": { "production": {} }
}
